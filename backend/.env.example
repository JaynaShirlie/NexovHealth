# ElevenLabs (STT + TTS)  https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# Optional: any voice id your account can use (default is the premade "Jessica")
ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9

# Groq (LLM, recommended for low latency, free tier)  https://console.groq.com/keys
# When set, Groq answers first and the Gemini models below are automatic fallbacks.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini (LLM)  https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Fallbacks used automatically when the main model is rate-limited (free quota is per model)
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.7-flash

# Optional server settings (defaults shown)
# CLINIC_TIMEZONE=Asia/Kolkata
# MAX_CONCURRENT_CALLS=3
# CALL_IDLE_TIMEOUT_SECS=120
# ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# PORT=7860
# LOG_LEVEL=INFO
